package-as: EverythingDelves

curse-id: 1519355

enable-nolib-creation: no

changelog-title: Everything Delves
manual-changelog:
  filename: .release_changelog.md
  markup-type: markdown

ignore:
  - .pkgmeta
  - .github
  - .gitignore
  - .gitattributes
  - .luacheckrc
  - README.md
  - CHANGELOG.md
  - .vscode
  - screenshots
  - docs
  - .release_changelog.md
